import Alvoki.Storage.Disk.RecoveredPinRefinement

namespace Alvoki.Storage
open Alvoki.Sequential (SnapshotTable)

/-- Legacy open trims only the incomplete tail before validating every complete
frame and replaying the suffix above the checkpoint watermark. -/
@[macro_inline] def recoverLegacy (base : PackedTable) (bytes : ByteArray) :
    Except String (ByteArray × PackedTable) := do
  let selected := (WAL.repairPrefix bytes).getD bytes
  let table ← recoverSelected base selected
  return (selected, table)

/-- Interpret the earlier legacy adoption protocol in the historical effect model. -/
@[macro_inline] def withLegacyRecoveredOpen [Monad m] {α : Type}
    (checkpoint : Option (PackedTable × UInt64)) (readMarker readWal : m (Option ByteArray))
    (validate : {β : Type} → Except String β → m β) (fail : {β : Type} → String → m β)
    (createWal : Unit → m Unit)
    (repairWal : ByteArray → m Unit) (syncWal : Unit → m Unit) (publishMarker : Nat → m Unit)
    (install : PackedTable → UInt64 → Nat → m α) : m α := do
  let (base, generation) := checkpoint.getD (.empty, 0)
  WAL.Boundary.withOpenWal readMarker readWal validate (fun boundary => do
    if checkpoint.isSome || boundary.isSome then
      fail WAL.Boundary.missingOpenWal
    else
      createWal ()
      pure ByteArray.empty) fun boundary bytes => do
    let (selected, table) ← validate <| match boundary with
      | some count => WAL.Boundary.recoverMarked base count bytes
      | none => recoverLegacy base bytes
    -- Both paths settle the visible checkpoint and marker before installation.
    let table ← Publication.finishReopen bytes.size selected.size
      (fun _ => repairWal selected) syncWal table
    if boundary.isNone then
      unless selected.size < UInt64.size do fail "WAL byte count is too large"
      publishMarker selected.size
    install table generation selected.size

/-- Successful legacy recovery selects the exact complete prefix of the
bytes it read. Its watermark check rules out a checkpoint that covers more
frames than this prefix contains. -/
theorem recoverLegacy_exact {base table : PackedTable} {bytes selected : ByteArray}
    (opened : recoverLegacy base bytes = .ok (selected, table)) :
    ∃ events, WAL.decodeOrdinals bytes = .ok events ∧ selected = WAL.encode events ∧
      table.committed.toNat = events.length ∧ base.committed.toNat ≤ events.length ∧
      recoverSelected base selected = .ok table := by
  let prefixBytes := (WAL.repairPrefix bytes).getD bytes
  change (do let recovered ← recoverSelected base prefixBytes; pure (prefixBytes, recovered)) =
    .ok (selected, table) at opened
  cases recovered : recoverSelected base prefixBytes with
  | error => rw [recovered] at opened; contradiction
  | ok recoveredTable =>
    rw [recovered] at opened
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Except.ok.inj opened)
    obtain ⟨events, decoded, applied, count⟩ := recoverSelected_success recovered
    have original := (WAL.decodeOrdinals_repairPrefix bytes).symm.trans decoded
    have canonical : prefixBytes = WAL.encode events :=
      (WAL.repairPrefix_getD_eq_extract bytes).trans (WAL.decodeOrdinals_reencode original).symm
    rw [canonical, WAL.encode_size, Nat.mul_div_cancel_left _ (by decide : 0 < WAL.frameSize)] at count
    have advanced := replay_committed_count _ applied
    rw [count] at advanced
    exact ⟨events, original, canonical, count, by omega, recovered⟩

/-- A short tear after the complete frames cannot hide an invalid frame or
an incorrect ordinal inside that prefix. -/
theorem recoverLegacy_decode_error (base : PackedTable) {bytes : ByteArray} {message : String}
    (failed : WAL.decodeOrdinals bytes = .error message) :
    recoverLegacy base bytes = .error message := by
  unfold recoverLegacy recoverSelected
  dsimp only
  rw [WAL.decodeOrdinals_repairPrefix, failed]
  rfl

/-- The marker generated by legacy open selects the entire adopted prefix,
and recovery with that marker returns the same table. This describes the
bytes once the WAL and published marker are durable. -/
theorem recoverLegacy_marked {base table : PackedTable} {bytes selected : ByteArray}
    (opened : recoverLegacy base bytes = .ok (selected, table))
    (fits : selected.size < UInt64.size) :
    (do
      let length ← WAL.Boundary.decode (WAL.Boundary.encode selected.size.toUInt64)
      WAL.Boundary.recoverMarked base length selected) = .ok (selected, table) := by
  obtain ⟨events, _, canonical, _, _, recovered⟩ := recoverLegacy_exact opened
  rw [WAL.Boundary.decode_encode]
  change WAL.Boundary.recoverMarked base selected.size.toUInt64 selected = .ok (selected, table)
  have selectedByMarker := WAL.Boundary.select_encoded events ByteArray.empty (canonical ▸ fits)
  rw [ByteArray.append_empty, ← canonical] at selectedByMarker
  rw [WAL.Boundary.recoverMarked, selectedByMarker]
  change (do let reopened ← recoverSelected base selected; pure (selected, reopened)) =
    .ok (selected, table)
  rw [recovered]
  rfl

/-- Given the exact observed checkpoint files, the legacy bytes determine
the abstract replay and the table returned with a new pin registry. A
successful marker publication may adopt the selected prefix verbatim. -/
theorem CheckpointForRecovery.recoverLegacy_refines
    {image : CheckpointPublication.Image} {walSequence : UInt64} {manifest : Option ByteArray}
    {files : List ByteArray} {checkpoint table : PackedTable}
    {model : SnapshotTable UInt64} {loaded : Option (PackedTable × UInt64)} {bytes selected : ByteArray}
    (written : CheckpointForRecovery manifest files checkpoint)
    (accepted : image.Accepts walSequence (fun header stored =>
      CheckpointForRecovery (some (Manifest.encode header)) stored checkpoint) manifest)
    (reads : CheckpointReadObservations image manifest) (loadedResult : reads.result = .ok loaded)
    (refines : checkpoint.Refines model)
    (opened : recoverLegacy (loaded.getD (.empty, 0)).1 bytes = .ok (selected, table)) :
    ∃ events abstract next,
      WAL.decodeOrdinals bytes = .ok events ∧ selected = WAL.encode events ∧
      table.committed.toNat = events.length ∧ checkpoint.committed.toNat ≤ events.length ∧
      SnapshotWalReplay model (events.drop checkpoint.committed.toNat) abstract ∧
      table.Refines next ∧ next.table = abstract.table ∧
      next.committed = abstract.committed ∧ next.pins.floor = abstract.pins.floor ∧
      next.pins.active = [] := by
  obtain ⟨events, decoded, canonical, count, covered, replayed⟩ := recoverLegacy_exact opened
  have observed := written.loaded_observation accepted reads loadedResult
  obtain ⟨reference, referenceLoad, same⟩ := written.loads
  have loadedMatches := Except.ok.inj (observed.symm.trans referenceLoad)
  have watermark := (congrArg PackedTable.committed loadedMatches).trans same.committed
  rw [watermark] at covered
  let n := checkpoint.committed.toNat
  let before := events.take n
  let after := events.drop n
  have length : before.length = n := by
    change (events.take n).length = n
    rw [List.length_take]
    exact Nat.min_eq_left covered
  have whole : before ++ after = events := List.take_append_drop n events
  have ordinals : WAL.OrdinalsFrom 1 (before ++ after) := whole ▸ WAL.decodeOrdinals_sound decoded
  have exactLoad : manifest.elim (Except.ok PackedTable.empty)
      (fun bytes => Manifest.decode bytes >>= fun header => loadRunSet header files) =
        .ok (loaded.getD (.empty, 0)).1 := by
    cases manifest <;> exact observed
  have exactReplay : (manifest.elim (Except.ok PackedTable.empty)
      (fun bytes => Manifest.decode bytes >>= fun header => loadRunSet header files) >>= fun base =>
        recoverSelected base (WAL.encode (before ++ after))) = .ok table := by
    rw [exactLoad, whole, ← canonical]
    exact replayed
  obtain ⟨abstract, next, replay, refined, data, clock, floor, pins⟩ :=
    recoverSelectedCheckpoint_refines_recoveredPins written refines length ordinals exactReplay
  exact ⟨events, abstract, next, decoded, canonical, count, covered, replay, refined, data, clock, floor, pins⟩

end Alvoki.Storage
