+private def syncPathsPlain (paths : Array FilePath) : IO Unit := do
+  let arguments := paths.map FilePath.toString
+  let child ← IO.Process.spawn { cmd := "sync", args := #["--"] ++ arguments, stdout := .null, stderr := .inherit, stdin := .null }
+  let status ← child.wait
+  unless status == 0 do throw (IO.userError s!"sync failed for {arguments} with exit code {status}")
+
+private def syncPathsStderr (paths : Array FilePath) : IO Unit := do
+  let arguments := paths.map FilePath.toString
+  let child ← IO.Process.spawn { cmd := "sync", args := #["--"] ++ arguments, stdout := .null, stderr := .piped, stdin := .null }
+  let error ← child.stderr.readToEnd
+  let status ← child.wait
+  unless status == 0 do throw (IO.userError s!"sync failed for {arguments}: {error}")
+
+private def publishWalExperiment (db : DiskTable) (bytes : Nat) : IO Unit := do
+  let dir := db.dir
+  let staged := dir.file .stagedWalBoundary
+  let active := dir.file .walBoundary
+  let walPath := dir.file .wal
+  let marker := WAL.Boundary.encode bytes.toUInt64
+  let publishWorker (worker : IO.Process.Child workerStdio) : IO Unit := Publication.run fun
+    | .writeStaged => writeFlushed staged marker
+    | .syncStaged => requestSync worker 70
+    | .renameStaged => IO.FS.rename staged active
+    | .syncDirectory => requestSync worker 68
+  if db.mode == "once" then
+    let worker ← startWorker dir.path "once"
+    try
+      publishWorker worker
+      awaitWorker worker
+    catch err =>
+      try worker.kill catch _ => pure ()
+      let _ ← worker.wait
+      throw err
+  else if let some worker := db.worker then
+    publishWorker worker
+  else if db.mode == "plain" || db.mode == "stderr" then
+    let sync := if db.mode == "plain" then syncPathsPlain else syncPathsStderr
+    Publication.run fun
+      | .writeStaged => writeFlushed staged marker
+      | .syncStaged => sync #[walPath, staged]
+      | .renameStaged => IO.FS.rename staged active
+      | .syncDirectory => sync #[dir.path]
+  else if db.mode == "direct" then
+    writeFlushed staged marker
+    let result ← IO.Process.output { cmd := ← workerExe, args := #["direct", dir.path.toString] }
+    unless result.exitCode == 0 do throw (IO.userError s!"direct helper: {result.stderr}")
+  else
+    publishWalBoundary dir bytes #[walPath]
+
