+private def workerStdio : IO.Process.StdioConfig :=
+  { stdin := .piped, stdout := .piped, stderr := .inherit }
+
+private def workerExe : IO String := do
+  let some exe ← IO.getEnv "ALVOKI_LATENCY_HELPER" | throw (IO.userError "missing benchmark helper")
+  return exe
+
+private def expectWorker (worker : IO.Process.Child workerStdio) (byte : UInt8) : IO Unit := do
+  let reply ← worker.stdout.read 1
+  unless reply.size == 1 && reply[0]! == byte do
+    throw (IO.userError "sync helper did not confirm durable operation")
+
+private def startWorker (dir : FilePath) (mode : String) : IO (IO.Process.Child workerStdio) := do
+  let worker ← IO.Process.spawn { toStdioConfig := workerStdio, cmd := ← workerExe, args := #[mode, dir.toString] }
+  try
+    expectWorker worker 82
+    return worker
+  catch err =>
+    try worker.kill catch _ => pure ()
+    let _ ← worker.wait
+    throw err
+
+private def requestSync (worker : IO.Process.Child workerStdio) (command : UInt8) : IO Unit := do
+  worker.stdin.write (ByteArray.mk #[command])
+  worker.stdin.flush
+  expectWorker worker 89
+
+private def awaitWorker (worker : IO.Process.Child workerStdio) : IO Unit := do
+  let status ← worker.wait
+  unless status == 0 do throw (IO.userError s!"sync helper failed with exit code {status}")
+
